# ---------------------------------------------------------------------------
# Supply-chain policy. See docs/IMPLEMENTATION-PLAN.md section 2.
# ---------------------------------------------------------------------------

# Do not install any version published less than 7 days ago.
#
# REQUIRES npm >= 11.10.0 (February 2026). On older npm this key is silently
# ignored, which is worse than not having it -- `engines.npm` in package.json
# states the requirement so it fails loudly instead. Check with `npm --version`.
#
# This single line would have blocked Shai-Hulud, Glassworm and the axios and
# LiteLLM incidents: every one of them was detected in under 7 days.
min-release-age=7

# Lifecycle scripts (preinstall/postinstall) are the execution vector of every
# known npm worm. Disabled globally; re-enable one package at a time with
# `npm rebuild <package>` if one ever genuinely needs it.
ignore-scripts=true

# Exact versions. No ^ or ~. The lockfile is the source of truth.
save-exact=true
package-lock=true

audit-level=high
fund=false
