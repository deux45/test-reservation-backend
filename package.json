{
  "name": "reservations-api",
  "version": "0.3.1",
  "description": "Shared resource booking API — NestJS + PostgreSQL",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=24",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug 0.0.0.0:9229 --watch",
    "start:prod": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "migration:run": "node dist/database/run-migrations.js",
    "migration:run:dev": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert:dev": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:show:dev": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "seed": "node dist/database/seeds/run-seeds.js",
    "seed:dev": "nest build && node dist/database/seeds/run-seeds.js",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "audit:osv": "node scripts/osv-check.mjs",
    "audit:signatures": "npm audit signatures",
    "audit:vulns": "npm audit --audit-level=high",
    "release": "commit-and-tag-version",
    "release:dry": "commit-and-tag-version --dry-run",
    "prepare": "husky"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/typeorm": "11.0.3",
    "better-auth": "1.7.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "date-fns": "4.4.0",
    "dotenv": "17.2.4",
    "nestjs-pino": "4.6.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.1",
    "@testcontainers/postgresql": "12.1.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.3.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "commit-and-tag-version": "13.1.2",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "lint-staged": "17.3.0",
    "pino-pretty": "13.1.2",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "testcontainers": "12.1.0",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
