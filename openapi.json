  },
  "info": {
    "title": "Shared Resource Booking API",
    "description": "Booking API for shared resources.\n\n**Central rule:** two `CONFIRMED` reservations never overlap on the same resource.\nIntervals are half-open `[start, end)`, so 10:00–11:00 and 11:00–12:00 are\ncontiguous and both valid.\n\nErrors follow RFC 7807 (`application/problem+json`).",
    "version": "0.3.1",
    "contact": {}
  },
  "tags": [
    {
      "name": "Health",
      "description": "Liveness and readiness"
    },
    {
      "name": "Resource types",
      "description": "Families of bookable resources"
    },
    {
      "name": "Resources",
      "description": "Create, list, update and deactivate bookable resources"
    },
    {
      "name": "Availability",
      "description": "Free slots for a resource within a range"
    },
    {
      "name": "Reservations",
      "description": "Create, list, reschedule and cancel reservations"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Session cookie issued by POST /api/auth/sign-in/email"
      }
    },
    "schemas": {
      "PaginationMetaDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "example": 1
          },
          "limit": {
            "type": "number",
            "example": 20
          },
          "total": {
            "type": "number",
            "example": 137
          },
          "totalPages": {
            "type": "number",
            "example": 7
          }
        },
        "required": ["page", "limit", "total", "totalPages"]
      },
      "PaginatedResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "description": "Declared explicitly as an untyped array.\n\nSwagger cannot resolve `T` at runtime, and letting the CLI plugin infer\nit makes the schema self-referential -- the app fails to boot with\n\"circular dependency detected (property key: data)\". The real item type\nis composed by ApiPaginatedResponse() below, via allOf.",
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMetaDto"
          }
        },
        "required": ["data", "meta"]
      },
      "ResourceTypeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "meeting-room"
          },
          "name": {
            "type": "string",
            "example": "Sala de reuniones"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "required": ["id", "code", "name", "isActive"]
      },
      "ResourceDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "aurora"
          },
          "name": {
            "type": "string",
            "example": "Sala Aurora"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "capacity": {
            "type": "number",
            "nullable": true,
            "example": 12
          },
          "location": {
            "type": "string",
            "nullable": true,
            "example": "Planta 2"
          },
          "timeZone": {
            "type": "string",
            "description": "IANA zone. The client formats times in this zone, not the browser's.",
            "example": "Europe/Madrid"
          },
          "isActive": {
            "type": "boolean"
          },
          "resourceType": {
            "$ref": "#/components/schemas/ResourceTypeDto"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": ["id", "code", "name", "timeZone", "isActive", "createdAt"]
      },
      "CreateResourceDto": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "capacity": {
            "type": "number",
            "description": "Maximum capacity. Checked against each reservation's attendees.",
            "minimum": 1,
            "example": 12
          },
          "location": {
            "type": "string",
            "maxLength": 160,
            "example": "Planta 2"
          },
          "timeZone": {
            "type": "string",
            "description": "IANA zone, for example Europe/Madrid.\n\nOperating hours are interpreted in this zone; instants are always stored\nin UTC.",
            "maxLength": 64,
            "example": "Europe/Madrid",
            "default": "UTC"
          },
          "resourceTypeId": {
            "type": "string",
            "description": "The type it belongs to.",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "description": "Unique, stable code. Lowercase letters, digits and hyphens.",
            "maxLength": 60,
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "description": "Display name.",
            "maxLength": 160
          }
        },
        "required": ["resourceTypeId", "code", "name"]
      },
      "UpdateResourceDto": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "capacity": {
            "type": "number",
            "description": "Maximum capacity. Checked against each reservation's attendees.",
            "minimum": 1,
            "example": 12
          },
          "location": {
            "type": "string",
            "maxLength": 160,
            "example": "Planta 2"
          },
          "timeZone": {
            "type": "string",
            "description": "IANA zone, for example Europe/Madrid.\n\nOperating hours are interpreted in this zone; instants are always stored\nin UTC.",
            "maxLength": 64,
            "example": "Europe/Madrid",
            "default": "UTC"
          },
          "name": {
            "type": "string",
            "description": "Display name.",
            "maxLength": 160
          }
        }
      },
      "CreateResourceTypeDto": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Unique, stable code. Lowercase letters, digits and hyphens.",
            "maxLength": 60,
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "description": "Display name of the type.",
            "maxLength": 120
          }
        },
        "required": ["code", "name"]
      },
      "CreateReservationDto": {
        "type": "object",
        "properties": {
          "startAt": {
            "type": "string",
            "description": "Start in UTC, ISO 8601. **Inclusive.**\n\nMust fall on a multiple of 15 minutes.",
            "example": "2026-09-15T10:00:00Z"
          },
          "endAt": {
            "type": "string",
            "description": "End in UTC, ISO 8601. **Exclusive.**\n\nA reservation ending at 11:00 does not collide with one starting at\n11:00: intervals are half-open `[start, end)`.",
            "example": "2026-09-15T11:00:00Z"
          },
          "attendees": {
            "type": "number",
            "description": "Expected attendees. Checked against the resource's capacity.",
            "minimum": 1,
            "example": 8
          },
          "notes": {
            "type": "string"
          },
          "resourceId": {
            "type": "string",
            "description": "The resource to book.",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "description": "Title shown in the schedule.",
            "maxLength": 160
          }
        },
        "required": ["startAt", "endAt", "resourceId", "title"]
      },
      "ReservationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "startAt": {
            "format": "date-time",
            "type": "string",
            "description": "Start in UTC. Inclusive."
          },
          "endAt": {
            "format": "date-time",
            "type": "string",
            "description": "End in UTC. **Exclusive.**"
          },
          "status": {
            "enum": ["CONFIRMED", "CANCELLED", "COMPLETED"],
            "type": "string"
          },
          "attendees": {
            "type": "number",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "userId": {
            "type": "string"
          },
          "resourceId": {
            "type": "string"
          },
          "resource": {
            "$ref": "#/components/schemas/ResourceDto"
          },
          "cancelledAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "cancellationReason": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "startAt",
          "endAt",
          "status",
          "userId",
          "resourceId",
          "createdAt"
        ]
      },
      "CancelReservationDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "Reason for the cancellation. It is recorded.",
            "maxLength": 300,
            "example": "The meeting is postponed"
          }
        }
      },
      "AvailabilitySlotDto": {
        "type": "object",
        "properties": {
          "startAt": {
            "format": "date-time",
            "type": "string",
            "description": "Start of the slot, UTC. Inclusive."
          },
          "endAt": {
            "format": "date-time",
            "type": "string",
            "description": "End of the slot, UTC. **Exclusive.**"
          },
          "durationMinutes": {
            "type": "number",
            "example": 60
          },
          "timeZone": {
            "type": "string",
            "description": "The zone the client should render the slot in.\n\nCarried on every slot so the client does not have to cross-reference the\nresource in a second request just to know how to display it.",
            "example": "Europe/Madrid"
          }
        },
        "required": ["startAt", "endAt", "durationMinutes", "timeZone"]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "enum": ["admin", "user"],
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "banned": {
            "type": "boolean"
          },
          "activeReservations": {
            "type": "number",
            "description": "Future confirmed reservations. Shown so an admin sees the impact of a ban.",
            "example": 3
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role",
          "emailVerified",
          "banned",
          "activeReservations",
          "createdAt"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "description": "At least 10 characters, the same as public sign-up.",
            "minLength": 10
          },
          "role": {
            "description": "Defaults to `user`.",
            "enum": ["admin", "user"],
            "type": "string",
            "default": "user"
          },
          "email": {
            "type": "string",
            "description": "Email, unique across the system.",
            "format": "email"
          },
          "name": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": ["password", "email", "name"]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Display name.",
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "description": "Email. It must remain unique.\n\nChanging it changes the credential this person signs in with, which is\nwhy the interface warns before saving.",
            "format": "email"
          }
        }
      },
      "UpdateRoleDto": {
        "type": "object",
        "properties": {
          "role": {
            "description": "The new role. Only `admin` or `user`.",
            "enum": ["admin", "user"],
            "type": "string"
          }
        },
        "required": ["role"]
      },
      "BanUserDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "Reason for the ban. It is recorded.",
            "maxLength": 300,
            "example": "Misuse of the meeting rooms"
          },
          "days": {
            "type": "number",
            "description": "Duration in days. With no value the ban is indefinite.\n\nBetter Auth lifts the ban itself once it expires, so no scheduled job is\nneeded to check for it.",
            "minimum": 1,
            "example": 30
          }
        }
      }
    }
  }
}
