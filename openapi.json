          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Page number, starting at 1.",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Results per page.",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "sortOrder",
            "required": false,
            "in": "query",
            "schema": {
              "default": "DESC",
              "type": "string",
              "enum": ["ASC", "DESC"]
            }
          },
          {
            "name": "sortBy",
            "required": false,
            "in": "query",
            "description": "Sort field. Each controller restricts the allowed values, because\ninterpolating a client-supplied column name into ORDER BY is an injection\nvector that no parameter binding protects against.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "typeId",
            "required": false,
            "in": "query",
            "description": "Only resources of this type.",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Searches name and code.",
            "schema": {
              "example": "aurora",
              "type": "string"
            }
          },
          {
            "name": "minCapacity",
            "required": false,
            "in": "query",
            "description": "Minimum capacity.",
            "schema": {
              "minimum": 1,
              "example": 8,
              "type": "number"
            }
          },
          {
            "name": "location",
            "required": false,
            "in": "query",
            "schema": {
              "example": "Planta 2",
              "type": "string"
            }
          },
          {
            "name": "isActive",
            "required": false,
            "in": "query",
            "description": "By default both active and inactive are shown.",
            "schema": {
              "example": true,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedResponseDto"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ResourceDto"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "List resources with filters and pagination",
        "tags": ["Resources"]
      },
      "post": {
        "description": "Registers a bookable resource under an existing type.",
        "operationId": "ResourcesController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateResourceDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceDto"
                }
              }
            }
          },
          "409": {
            "description": "A resource with that code already exists"
          },
          "422": {
            "description": "The time zone is not valid"
          }
        },
        "summary": "Create a resource",
        "tags": ["Resources"]
      }
    },
