              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationDto"
                }
              }
            }
          }
        },
        "summary": "Cancel a reservation",
        "tags": ["Reservations"]
      }
    },
    "/api/v1/resources/{id}/availability": {
      "get": {
        "description": "Starts from the resource's operating hours and subtracts maintenance blocks and confirmed reservations. Slots are half-open `[start, end)`, exactly like reservations: one ending at 11:00 leaves 11:00 free.\n\nA resource with no schedule configured is available around the clock.",
        "operationId": "AvailabilityController_findSlots",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "required": true,
            "in": "query",
            "description": "Start of the range to query, UTC ISO 8601.",
            "schema": {
              "example": "2026-12-15T00:00:00Z",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": true,
            "in": "query",
            "description": "End of the range. At most 60 days from `from`.",
            "schema": {
              "example": "2026-12-16T00:00:00Z",
              "type": "string"
            }
          },
          {
            "name": "minDurationMinutes",
            "required": false,
            "in": "query",
            "description": "Discards slots shorter than this.\n\nOffering a 15-minute slot to someone who needs an hour only produces a\nfailed attempt.",
            "schema": {
              "minimum": 15,
              "maximum": 480,
              "default": 15,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AvailabilitySlotDto"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid range, or longer than 60 days"
          }
        },
        "summary": "Free slots for a resource within a range",
        "tags": ["Availability"]
      }
    },
