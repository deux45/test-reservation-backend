    "/api/v1/reservations": {
      "post": {
        "description": "Applies every business rule and guarantees there is no overlap. Intervals are half-open `[start, end)`: a reservation ending at 11:00 does not clash with one starting at 11:00.",
        "operationId": "ReservationsController_create",
        "parameters": [
          {
            "name": "idempotency-key",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Repeating the request with the same key returns the reservation already created instead of creating a second one.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReservationDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationDto"
                }
              }
            }
          },
          "409": {
            "description": "The slot is already taken (`OVERLAPPING_RESERVATION`, carrying the conflicting range), or a rule forbids it: outside operating hours, resource blocked, or the active reservation limit reached."
          },
          "422": {
            "description": "Invalid range, a range in the past, or attendees above capacity."
          }
        },
        "summary": "Create a reservation",
        "tags": ["Reservations"]
      },
      "get": {
        "description": "Without the admin role only your own are returned, and the userId parameter is ignored. The range returns reservations that **overlap** it.",
        "operationId": "ReservationsController_findAll",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Page number, starting at 1.",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Results per page.",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "sortOrder",
            "required": false,
            "in": "query",
            "schema": {
              "default": "DESC",
              "type": "string",
              "enum": ["ASC", "DESC"]
            }
          },
          {
            "name": "sortBy",
            "required": false,
            "in": "query",
            "description": "Sort field. Each controller restricts the allowed values, because\ninterpolating a client-supplied column name into ORDER BY is an injection\nvector that no parameter binding protects against.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "resourceId",
            "required": false,
            "in": "query",
            "description": "Filter by resource.",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "userId",
            "required": false,
            "in": "query",
            "description": "Filter by user. Ignored without the admin role: you only see your own.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "resourceTypeId",
            "required": false,
            "in": "query",
            "description": "Every reservation for one family of resources.",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Repeatable: `?status=CONFIRMED&status=CANCELLED`.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["CONFIRMED", "CANCELLED", "COMPLETED"]
              }
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "Returns the reservations that **overlap** the range, not those contained\nwithin it: asking \"what is booked this week\" must include the meeting\nthat started on Friday and ends on Monday.",
            "schema": {
              "example": "2026-09-01T00:00:00Z",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "schema": {
              "example": "2026-09-30T23:59:59Z",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedResponseDto"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ReservationDto"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "List reservations with filters and pagination",
        "tags": ["Reservations"]
      }
    },
