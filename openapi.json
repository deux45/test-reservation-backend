        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationDto"
                }
              }
            }
          }
        },
        "summary": "Reschedule a reservation",
        "tags": ["Reservations"]
      }
    },
    "/api/v1/reservations/{id}/cancellation": {
      "post": {
        "description": "Idempotent: cancelling an already cancelled reservation returns 200. The slot is freed immediately, because the constraint only indexes CONFIRMED rows.",
        "operationId": "ReservationsController_cancel",
        "parameters": [
