# Normalise line endings to LF in the repository, whatever the checkout OS.
# Without this, a commit made on Windows shows every line as changed to a
# reviewer on Linux or macOS.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.ico binary
*.pdf binary

# Generated: collapse it in diffs so a lockfile bump does not bury the review.
package-lock.json linguist-generated=true -diff
