{
  "$schema": "https://raw.githubusercontent.com/absolute-version/commit-and-tag-version/master/schema.json",
  "header": "# Changelog\n\nEvery release of this project is documented here.\n\nThe format follows [Keep a Changelog](https://keepachangelog.com/en/1.1.0/)\nand the versioning follows [Semantic Versioning](https://semver.org/).\n\n> Generated by `commit-and-tag-version` from the commit messages.\n> **Not edited by hand**: if an entry reads badly, the problem is in the\n> commit message.\n>\n> Cutting a release: `npm run release` (or the _Release_ workflow on GitHub).\n",
  "types": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": false
    },
    {
      "type": "build",
      "section": "Build and dependencies",
      "hidden": false
    },
    {
      "type": "refactor",
      "section": "Refactoring",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "style",
      "hidden": true
    },
    {
      "type": "ci",
      "hidden": true
    },
    {
      "type": "chore",
      "hidden": true
    }
  ],
  "commitUrlFormat": "{{host}}/{{owner}}/{{repository}}/commit/{{hash}}",
  "compareUrlFormat": "{{host}}/{{owner}}/{{repository}}/compare/{{previousTag}}...{{currentTag}}",
  "issueUrlFormat": "{{host}}/{{owner}}/{{repository}}/issues/{{id}}",
  "releaseCommitMessageFormat": "chore(release): {{currentTag}}",
  "tagPrefix": "v",
  "skip": {
    "commit": false,
    "tag": false
  }
}
